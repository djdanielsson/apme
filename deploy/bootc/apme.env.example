# APME bootc runtime configuration template (ADR-054 / ADR-061).
# Copy to /etc/apme/env/apme.env on the deployed VM before first boot.
# Do not commit secrets.
#
# Gateway persistence (required) — point at a PostgreSQL service reachable from
# the pod. Remote production hosts require certificate-validated TLS
# (?sslmode=verify-full and a configured CA).
# APME_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/apme

# Galaxy Proxy administration (required) — set a random ASCII token locally.
# Engine, Gateway, and proxy read this file and must share the same token.
APME_PROXY_ADMIN_TOKEN=

# AI provider (optional — leave empty to disable Abbenay-backed remediation)
APME_AI_MODEL=
OPENROUTER_API_KEY=
VERTEX_ANTHROPIC_API_KEY=

# Engine scan/remediation deadlines (seconds); defaults are doubled for slower hosts.
APME_SESSION_TTL=3600
APME_SESSION_MAX_LIFETIME=14400
APME_SESSION_VENV_BUILD_WAIT_S=1200
APME_OPERATION_SCAN_BASE=600
APME_OPERATION_MIN_BUDGET=1200
APME_OPERATION_PER_CALL_TIMEOUT=120
APME_OPERATION_STALL_SECONDS=1200
APME_OPERATION_TIER1_PER_VIOLATION=4
APME_OPERATION_TIER1_MARGIN_CAP=1200

# Gateway feedback (optional)
APME_FEEDBACK_ENABLED=false
APME_FEEDBACK_GITHUB_REPO=
APME_FEEDBACK_GITHUB_TOKEN=
